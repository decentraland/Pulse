{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.Hosting.Lifetime": "Warning",
      "NATS.Client.Core": "Warning"
    }
  },
  "Transport": {
    "BindHost": "0.0.0.0",
    "Port": 7777,
    "MaxPeers": 4095,
    "MaxConcurrentConnections": 0,
    "ServiceTimeoutMs": 1000,
    "BufferSize": 4096,
    "PeerTimeoutMs": 5000,
    "Hardening": {
      "PreAuth": {
        "PreAuthBudget": 512,
        "MaxConcurrentPreAuthPerIP": 32
      },
      "CorruptedPacket": {
        "MaxPerMinute": 5,
        "BurstCapacity": 5
      }
    }
  },
  "WebTransport": {
    "Enabled": false,
    "BindHost": "0.0.0.0",
    "Port": 7743,
    "MaxDatagramBytes": 1200,
    "MaxMessageBytes": 4096
  },
  "Messaging": {
    "Hardening": {
      "Handshake": {
        "MaxAttempts": 2
      },
      "MovementInput": {
        "MaxHz": 20,
        "BurstCapacity": 16
      },
      "DiscreteEvent": {
        "RatePerSecond": 20,
        "BurstCapacity": 16
      },
      "FieldValidator": {
        "MaxRealmLength": 255,
        "MaxEmoteDurationMs": 60000
      },
      "HandshakeReplay": {
        "Enabled": true
      },
      "Bans": {
        "PollIntervalSeconds": 30,
        "HttpTimeoutSeconds": 10
      }
    }
  },
  "Peers": {
    "SnapshotHistoryCapacity": 20,
    "SimulationSteps": [50, 100, 200],
    "SelfMirrorEnabled": false,
    "SelfMirrorTier": 0,
    "DisconnectionCleanTimeoutMs": 5000,
    "PendingAuthCleanTimeoutMs": 30000
  },
  "SpatialHashAreaOfInterest": {
    "Tier0Radius": 30,
    "Tier1Radius": 60,
    "MaxRadius": 200,
    "CellSize": 100,
    "ScanCellRadius": 2
  },
  "ParcelEncoder": {
    "MinParcelX": -150,
    "MinParcelZ":-150,
    "MaxParcelX": 163,
    "MaxParcelZ": 158,
    "Padding": 2,
    "ParcelSize": 16
  },
  "SceneListener": {
    "MaxParcels": 4096
  },
  "Clusters": {
    "Enabled": true,
    "PassIntervalMs": 1000,
    "DwellPasses": 3,
    "IdPrefix": "C",
    "SessionRetentionPasses": 300
  },
  "Nats": {
    "Url": "",
    // Blank means "not configured": ServerName then resolves to pulse-<hostname>
    // (Environment.MachineName), which is also the server_name on engine.discovery and the NATS
    // client's connection name. That default is unique per HOST, not per process — the pod name
    // under default Kubernetes networking, but the node name under `hostNetwork: true` or a
    // deployment-wide `spec.hostname`, and shared by every Pulse process on one machine. Set it
    // explicitly in any of those, to something already unique per replica: two replicas sharing
    // one server_name delete each other's population from every presence consumer, silently
    // (docs/presence-feed.md#server_name-must-be-unique-per-replica).
    "ServerName": "",
    "DiscoveryIntervalMs": 10000,
    "ChannelCapacity": 1024
  },
  "Presence": {
    "Enabled": true,
    "BatchIntervalMs": 2000,
    "SnapshotIntervalMs": 60000
  },
  "Metrics": {
    "Type": "Prometheus"
  },
  "HttpService": {
    "Port": 5000
  }
}
