<Project Sdk="Microsoft.NET.Sdk.Worker">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>dotnet-DCLPulse-afa00325-7b93-4586-87fa-af77c2a6a95e</UserSecretsId>
        <RootNamespace>Pulse</RootNamespace>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
      <DebugType>full</DebugType>
      <DebugSymbols>true</DebugSymbols>
      <Optimize>false</Optimize>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="DCLPulseTests" />
        <InternalsVisibleTo Include="DCLPulseBenchmarks" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.3" />
        <!-- Core of the official NATS .NET client, pure managed. The NATS.Net umbrella package also
             pulls JetStream / KeyValueStore / ObjectStore / Services, which a publish-only feed
             never uses.

             Before bumping this: NatsPublisher pools the message instances it publishes and returns
             each one once its PublishAsync task completes, which is only safe while the client has
             finished serializing by then. In 3.0.1 CommandWriter.PublishAsync serializes
             synchronously ahead of its state machine, and the not-yet-connected path
             (NatsConnection.ConnectAndPublishAsync) awaits the connect and then serializes, still
             inside the awaited task. A release that captured the value and serialized it later would
             turn that return into a use-after-return, with no test to catch it.

             Also load-bearing: PublishTimeoutOnDisconnected defaults to false, so a publish issued
             while the broker is down waits for the reconnect instead of throwing at CommandTimeout. A
             release that flipped that default would drain NatsPublisher's outbox into failed publishes
             for the length of every outage. -->
        <PackageReference Include="NATS.Client.Core" Version="3.0.1" />
        <PackageReference Include="XenoAtom.Terminal.UI" Version="2.0.2" />
        <PackageReference Include="ZLogger" Version="2.5.10" />
        <PackageReference Include="Decentraland.RustWebTransport" Version="$(RustWebTransportVersion)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DCLAuth\DCLAuth.csproj" />
        <ProjectReference Include="..\DCLPulse.Transport\DCLPulse.Transport.csproj" />
        <ProjectReference Include="..\Protocol\Protocol.csproj" />
    </ItemGroup>

    <!-- The Worker SDK only auto-copies appsettings*.json to the output directory; the default
         content glob picks this file up but leaves it uncopied, so the metadata is set here. -->
    <ItemGroup>
        <Content Update="dynamicconfig.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <None Include="runtimes\win-x64\native\enet.dll">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <TargetPath>enet.dll</TargetPath>
        </None>
        <None Include="runtimes\linux-x64\native\libenet.so">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <TargetPath>libenet.so</TargetPath>
        </None>
        <None Include="runtimes\macos-arm64\native\libenet.dylib">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <TargetPath>libenet.dylib</TargetPath>
        </None>
    </ItemGroup>

    <!-- Geo database predownload for local runs. Docker images fetch their own fresh
         copies via ADD (which take precedence at runtime); Docker builds and CI set
         FetchGeoDb=false / CI=true so this never runs there. Delete packages/geodb
         to force a re-download. -->
    <PropertyGroup>
        <GeoDbCacheDir>$(MSBuildThisFileDirectory)..\..\packages\geodb\</GeoDbCacheDir>
    </PropertyGroup>

    <Target Name="FetchGeoDb" BeforeTargets="Build"
            Condition="'$(FetchGeoDb)' != 'false' and '$(CI)' == ''">
        <DownloadFile SourceUrl="https://cdn.jsdelivr.net/npm/@ip-location-db/geo-whois-asn-country/geo-whois-asn-country-ipv4-num.csv"
                      DestinationFolder="$(GeoDbCacheDir)"
                      Condition="!Exists('$(GeoDbCacheDir)geo-whois-asn-country-ipv4-num.csv')"
                      ContinueOnError="WarnAndContinue" />
        <DownloadFile SourceUrl="https://cdn.jsdelivr.net/npm/@ip-location-db/geo-whois-asn-country/geo-whois-asn-country-ipv6-num.csv"
                      DestinationFolder="$(GeoDbCacheDir)"
                      Condition="!Exists('$(GeoDbCacheDir)geo-whois-asn-country-ipv6-num.csv')"
                      ContinueOnError="WarnAndContinue" />
        <DownloadFile SourceUrl="https://download.geonames.org/export/dump/countryInfo.txt"
                      DestinationFolder="$(GeoDbCacheDir)"
                      Condition="!Exists('$(GeoDbCacheDir)countryInfo.txt')"
                      ContinueOnError="WarnAndContinue" />
        <ItemGroup>
            <GeoDbFiles Include="$(GeoDbCacheDir)*.csv" />
            <GeoDbFiles Include="$(GeoDbCacheDir)countryInfo.txt" />
        </ItemGroup>
        <Copy SourceFiles="@(GeoDbFiles)" DestinationFolder="$(OutDir)geodb"
              SkipUnchangedFiles="true" Condition="'@(GeoDbFiles)' != ''" />
    </Target>
</Project>
