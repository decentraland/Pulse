<Project Sdk="Microsoft.NET.Sdk.Worker">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>dotnet-DCLPulse-afa00325-7b93-4586-87fa-af77c2a6a95e</UserSecretsId>
        <RootNamespace>Pulse</RootNamespace>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
      <DebugType>full</DebugType>
      <DebugSymbols>true</DebugSymbols>
      <Optimize>false</Optimize>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="DCLPulseTests" />
        <InternalsVisibleTo Include="DCLPulseBenchmarks" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.3" />
        <!-- Core of the official NATS .NET client, pure managed. The NATS.Net umbrella package also
             pulls JetStream / KeyValueStore / ObjectStore / Services, which a publish-only feed
             never uses. -->
        <PackageReference Include="NATS.Client.Core" Version="3.0.1" />
        <PackageReference Include="XenoAtom.Terminal.UI" Version="2.0.2" />
        <PackageReference Include="ZLogger" Version="2.5.10" />
        <PackageReference Include="Decentraland.RustWebTransport" Version="$(RustWebTransportVersion)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DCLAuth\DCLAuth.csproj" />
        <ProjectReference Include="..\DCLPulse.Transport.Shared\DCLPulse.Transport.Shared.csproj" />
        <ProjectReference Include="..\Protocol\Protocol.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="runtimes\win-x64\native\enet.dll">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <TargetPath>enet.dll</TargetPath>
        </None>
        <None Include="runtimes\linux-x64\native\libenet.so">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <TargetPath>libenet.so</TargetPath>
        </None>
        <None Include="runtimes\macos-arm64\native\libenet.dylib">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <TargetPath>libenet.dylib</TargetPath>
        </None>
    </ItemGroup>
</Project>
